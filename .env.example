# Clerk publishable key (Clerk dashboard -> API Keys). Must be the same
# Clerk application/instance resume-api's JWT authorizer trusts
# (resume-api's CLERK_ISSUER_URL), with a "resume-api" JWT template configured.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for resume-api. Defaults to http://localhost:8000 (a locally
# running resume-api, e.g. via its ./scripts/run-local.sh) when unset.
# VITE_API_BASE_URL=http://localhost:8000
